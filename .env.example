# .env.example — Konfigurasi Lingkungan SignBridge ID-PH
# Salin berkas ini menjadi .env dan sesuaikan kredensial lokal Anda.
# JANGAN menyimpan password produksi asli di dalam repositori Git.

POSTGRES_USER=signbridge
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
POSTGRES_DB=signbridge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL Koneksi SQLAlchemy untuk PostgreSQL 16 Operasional & Telemetri:
DATABASE_URL=postgresql+psycopg2://signbridge:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/signbridge_db

# Jika PostgreSQL belum berjalan di mesin lokal, sistem otomatis menggunakan fallback aman:
SIGNBRIDGE_FALLBACK_DB_URL=sqlite:///./data/signbridge_operational.db

# Konfigurasi Server FastAPI
PORT=7860
RATE_LIMIT_PER_MIN=60

